# =============================================================================
# Application Environment Variables Template
# Copy this file to .env and adjust the values according to your environment.
# =============================================================================

# Database Configuration (PostgreSQL / AWS RDS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=userdb
DATABASE_URL=postgresql+psycopg2://postgres:postgres123@db:5432/userdb

# AWS Cloud Credentials & S3 Bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-s3-bucket-name
